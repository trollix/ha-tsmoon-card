{
  "name": "ha-tsmoon-card",
  "version": "0.21",
  "description": "Simple Moon Card",
  "main": "dist/tsmoon-card.js",
  "files": [
    "/dist"
  ],
  "scripts": {
    "build": "rimraf dist && npm run typecheck && npm run declarations && npm run rollup",
    "release": "rimraf dist && npm run typecheck && npm run declarations && rollup --environment release -c --bundleConfigAsCjs",
    "watch": "rollup -c --watch --bundleConfigAsCjs",
    "rollup": "rollup -c --bundleConfigAsCjs",
    "typecheck": "tsc --noEmit",
    "declarations": "tsc --emitDeclarationOnly"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/trollix/ha-tmoon-card.git"
  },
  "keywords": [
    "lovelace",
    "moon",
    "card",
    "home",
    "assistant"
  ],
  "author": "Trollix",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/trollix/ha-tsmoon-card/issues"
  },
  "homepage": "https://github.com/trollix/ha-tsmoon-card#readme",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-image": "^3.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@types/node": "^26.6.6",
    "@types/suncalc": "^1.9.2",
    "rimraf": "^6.1.4",
    "rollup": "^4.67.5",
    "rollup-plugin-import-css": "^4.2.1",
    "rollup-plugin-version-injector": "^1.3.3",
    "tslib": "^2.9.1",
    "typescript": "^7.0.2",
    "esbuild": "latest"
  },
  "dependencies": {
    "custom-card-helpers": "^2.0.0",
    "dayjs": "^1.11.23",
    "lit": "^3.3.3",
    "suncalc3": "2.0.5"
  },
  "resolutions": {
    "@formatjs/intl-utils": "https://registry.yarnpkg.com/@favware/skip-dependency/-/skip-dependency-1.2.1.tgz"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
